# FitTrack backend environment template.
# Copy to `.env` and fill in real values. NEVER commit real secrets.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fittrack

# Generate strong secrets in production: `openssl rand -hex 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Comma separated list of allowed CORS origins, or * for development
CLIENT_URL=*

# Cloudinary (optional - development falls back to placeholder media URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

LOG_LEVEL=info
